# The Yard — .env
# Copy this file to .env and fill it in. Never commit .env anywhere public.
# Everything not in here lives in the Settings screen at /admin.

# --- Telegram -----------------------------------------------------------
# Already set. From BotFather. Keep this exact key name.
TELEGRAM_TOKEN=

# --- Flask --------------------------------------------------------------
# Signs session cookies. Generate with:  python manage.py make-secret
FLASK_SECRET_KEY=

# --- Sign-ins -----------------------------------------------------------
# Hashes, never plain passwords. Generate with:
#   python manage.py set-admin-password
#   python manage.py set-staff-pin
#   python manage.py set-gm-pin
# The GM PIN is separate on purpose: the GM console shows the whole solution,
# and booth volunteers may have friends still waiting to play.
ADMIN_PASSWORD_HASH=
STAFF_PIN_HASH=
GM_PIN_HASH=

# --- Where the app lives ------------------------------------------------
# The public HTTPS address of the tunnel currently in use, no trailing slash.
# Event day:   https://theyard.tailXXXX.ts.net
# Development: https://<your-fixed-domain>.ngrok-free.app
# When you change this, restart bot.py and update the Mini App URL in BotFather.
PUBLIC_URL=

# Database, backups, receipts and imports. Leave as-is unless you move them.
DATA_DIR=data

# --- Access -------------------------------------------------------------
# Comma-separated, no @, lowercase. Always allowed even if not on the roster.
ALWAYS_ALLOW_HANDLES=maxi_muslim

# --- Paperform ----------------------------------------------------------
# Optional. The webhook at POST /paperform/webhook works with this left blank,
# which is how it is meant to run: the form sends no signature of its own.
# Fill it in with any long random string and the app will additionally require
# it in an X-Paperform-Secret header, rejecting anything without it.
# The webhook can be switched off entirely on the Settings screen.
PAPERFORM_WEBHOOK_SECRET=

# --- Time ---------------------------------------------------------------
# Times are stored in UTC and displayed in this zone.
TIMEZONE=Asia/Singapore
